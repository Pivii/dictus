{
  "sourceLanguage" : "en",
  "strings" : {
    "%@: could not be applied. Try again." : {
      "comment" : "Shown when an armed Smart Mode fails and nothing is inserted. The placeholder is the mode's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : n’a pas pu s’appliquer. Réessaie."
          }
        }
      }
    },
    "%@: too long, text inserted as dictated." : {
      "comment" : "Shown when a Smart Mode hit the context ceiling and the untransformed text was inserted instead. The placeholder is the mode's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : trop long, texte inséré tel quel."
          }
        }
      }
    },
    "%@: too long. Try a shorter dictation." : {
      "comment" : "Shown when a Smart Mode hit the context ceiling and could not fall back, so nothing was inserted. The placeholder is the mode's name.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : trop long. Essaie une dictée plus courte."
          }
        }
      }
    },
    "ABC" : {
      "comment" : "The text for the \"ABC\" button in the emoji category bar.",
      "isCommentAutoGenerated" : true
    },
    "Apple Intelligence is busy right now. Smart Modes will come back shortly." : {
      "comment" : "Shown in the Smart Mode fan while the process is rate-limited.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est occupé. Les modes reviennent dans un moment."
          }
        }
      }
    },
    "Apple Intelligence is still downloading. Smart Modes will work once it finishes." : {
      "comment" : "Shown in the Smart Mode fan while the on-device model is downloading.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence télécharge encore son modèle. Les modes marcheront ensuite."
          }
        }
      }
    },
