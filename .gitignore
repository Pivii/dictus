.idea/
.vscode/

# Archives
*.ipa
*.dSYM.zip
*.dSYM

# Whisper models (downloaded at runtime, too large for git)
*.mlmodelc
# Only ignore top-level Models/ directory (downloaded Whisper model files)
# DictusKeyboard/Models/ contains Swift source files and must be tracked
/Models/
Library/

# Python bytecode
__pycache__/
*.pyc

# Local logs + crash dumps
crash-logs.log
assets/reference/logs/**/*.log

# Design sandbox
designs/

# Playwright MCP session artifacts
.playwright-mcp/

