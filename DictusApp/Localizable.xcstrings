          }
        }
      }
    },
    "The first preparation of this model takes under a minute. It happens only once, and later ones take a few seconds." : {
      "comment" : "Preparation screen: shown for a model whose measured first compile is under a minute, such as Medium at 32s (issue #432).",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première préparation de ce modèle prend moins d'une minute. Elle n'a lieu qu'une fois, et les suivantes ne prennent que quelques secondes."
          }
        }
      }
    },
    "The download could not resume. Please try again." : {
      "comment" : "Model download error when a ranged response could not be appended to the partial already on disk (issue #449).",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
